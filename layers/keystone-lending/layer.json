  "dimensions": {
    "Affordability Result": {
      "kind": "field",
      "reference": {
        "view": "Applications",
        "field": "Affordability Result"
      },
      "resultType": "string",
      "description": "Default-policy affordability outcome: Pass (0 breaches), Marginal (1), Fail (2+)."
    },
    "Age Band": {
      "kind": "field",
      "reference": {
        "view": "Applications",
        "field": "Age Band"
      },
      "resultType": "string",
      "description": "Applicant age band."
    },
    "All Applications": {
      "kind": "field",
      "reference": {
        "view": "Applications",
        "field": "App Count"
      },
      "resultType": "number",
      "description": "A single value (1) shared by every application: the grain of portfolio-level headline figures."
    },
    "Applicant": {
      "kind": "field",
      "reference": {
        "view": "Applications",
        "field": "Applicant Id"
      },
