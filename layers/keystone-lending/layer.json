      "m2": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
              "field": "App Count"
            }
          }
        ]
      },
      "format": {
        "pattern": "0.0%"
      }
    },
    "Proposal Upheld Rate": {
      "description": "Decided applications where the approver confirmed the underwriter proposal.",
      "resultType": "float",
      "expression": "{m1} / {m2}",
      "m1": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
              "field": "Proposal Upheld"
            }
          }
        ]
      },
      "m2": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
              "field": "Is Decided"
            }
          }
        ]
      },
      "format": {
        "pattern": "0.0%"
      }
    },
    "Requested Lending": {
      "description": "Total amount requested.",
      "resultType": "float",
      "expression": "{m1}",
      "m1": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
              "field": "Requested Amount"
            }
          }
        ]
      },
      "format": {
        "pattern": "£#,##0"
      }
    }
