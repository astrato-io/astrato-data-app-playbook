  "joins": [
    {
      "views": [
        "Workflow Events",
        "Applications"
      ],
      "conditions": [
        {
          "operator": "equals",
          "arguments": [
            {
              "reference": {
                "view": "Workflow Events",
                "field": "Applicant Id"
              }
            },
            {
              "reference": {
                "view": "Applications",
                "field": "Applicant Id"
              }
            }
          ]
        }
      ],
      "cardinality": "many-to-one"
