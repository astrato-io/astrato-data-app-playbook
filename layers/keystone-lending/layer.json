  "measures": {
    "Applications": {
      "description": "Number of applications.",
      "resultType": "int",
      "expression": "{m1}",
      "m1": {
        "distinct": true,
        "aggregate": "COUNT",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
              "field": "Applicant Id"
            }
          }
        ]
      },
      "format": {
        "pattern": "#,##0"
      }
    },
    "Approval Rate": {
      "description": "Approved ÷ decided applications.",
      "resultType": "float",
      "expression": "{m1} / {m2}",
      "m1": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
              "field": "Is Approved"
            }
          }
        ]
      },
      "m2": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
              "field": "Is Decided"
            }
          }
        ]
      },
      "format": {
        "pattern": "0.0%"
      }
    },
    "Approved": {
      "description": "Approved applications.",
      "resultType": "float",
      "expression": "{m1}",
      "m1": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Applications",
