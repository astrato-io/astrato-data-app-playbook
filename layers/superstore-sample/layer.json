        "field": "Order Date"
      },
      "resultType": "date",
      "description": "Date the order was placed. 2016-01-03 to 2019-12-30 - the extract's own dates, not the source workbook's four-year shift."
    },
    "Region": {
      "kind": "field",
      "reference": {
        "view": "Orders",
        "field": "Region"
