      "kind": "field",
      "reference": {
        "view": "Orders",
        "field": "Sub-Category"
      },
      "resultType": "string",
      "description": "The seventeen product sub-categories. Machines and Tables are the loss-makers."
    }
  },
  "measures": {
    "Orders": {
      "description": "Distinct orders. An order has many lines, so this is a distinct count of Order ID, not a row count: 12,420 lines across 5,009 orders.",
      "resultType": "int",
      "expression": "{m1}",
      "m1": {
        "distinct": true,
        "aggregate": "COUNT",
        "arguments": [
          {
            "reference": {
              "view": "Orders",
              "field": "Order ID"
            }
          }
        ]
      },
      "format": {
        "pattern": "#,##0"
      }
    },
    "Profit": {
      "description": "Profit on order lines, in USD. Negative on discounted furniture and on most of the Machines sub-category.",
      "resultType": "float",
      "expression": "{m1}",
      "m1": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Orders",
              "field": "Profit"
            }
          }
        ]
      },
      "format": {
        "pattern": "$#,###.00"
      }
    },
    "Profit Ratio": {
      "description": "Profit as a share of sales. Both operands are Float64 in ClickHouse, not Decimal, so the division keeps its precision.",
      "resultType": "float",
      "expression": "{m1} / {m2}",
      "m1": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Orders",
              "field": "Profit"
            }
          }
        ]
      },
      "m2": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Orders",
              "field": "Sales"
            }
          }
        ]
      },
      "format": {
        "pattern": "##0.0%"
      }
    },
    "Returns": {
      "description": "Orders with a returned line. The flag is set on every line of a returned order, never on part of one: 3,226 flagged lines across exactly 296 orders.",
      "resultType": "int",
      "expression": "{m1}",
      "m1": {
        "distinct": true,
        "aggregate": "COUNT",
        "arguments": [
          {
            "reference": {
              "view": "Orders",
              "field": "Order ID"
            }
          }
        ],
        "filter": {
          "expression": "{f1}",
          "f1": {
            "operator": "equals",
            "arguments": [
              {
                "reference": {
                  "view": "Orders",
                  "field": "Returned"
                }
              },
              {
                "value": "Yes",
                "dataType": "string"
              }
            ]
          }
        }
      },
      "format": {
        "pattern": "#,##0"
      }
    },
    "Sales": {
      "description": "Net sales value of order lines, in USD.",
      "resultType": "float",
      "expression": "{m1}",
      "m1": {
        "aggregate": "SUM",
        "arguments": [
          {
            "reference": {
              "view": "Orders",
              "field": "Sales"
            }
          }
        ]
      },
      "format": {
        "pattern": "$#,###.00"
      }
    }
  },
